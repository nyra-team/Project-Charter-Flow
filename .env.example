# ─────────────────────────────────────────────────────────────────────
# Project Hub (PMO) — local environment template
# Copy to .env and fill in. The .env file is git-ignored.
# ─────────────────────────────────────────────────────────────────────

# Recruit Supabase project (rhhpmohhxlmylrnzdcoe), session-mode pooler.
# This is the DATA database (project hub rows live here via drizzle).
# Password (RECRUIT_DB_PW) must be set in the shell — not stored on disk.
DATABASE_URL=postgresql://postgres.rhhpmohhxlmylrnzdcoe:${RECRUIT_DB_PW}@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Master Employee DB (loqyxdhkfjnuaykxxwis) — used for SSO / JWT validation.
# Get the service-role key from Supabase dashboard → Project Settings → API.
# Never check the real value into git.
MASTER_DB_URL=https://loqyxdhkfjnuaykxxwis.supabase.co
MASTER_DB_SERVICE_ROLE_KEY=

# Required by express-session in production (any long random string).
# In dev a fallback is used automatically.
SESSION_SECRET=

NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# ─────────────────────────────────────────────────────────────────────
# Frontend (Vite) — project-hub
# ─────────────────────────────────────────────────────────────────────
VITE_MASTER_DB_URL=https://loqyxdhkfjnuaykxxwis.supabase.co
VITE_MASTER_DB_ANON_KEY=
# Portal /login URL — where unauthenticated users get redirected.
# Local dev: e.g. http://localhost:5173/login. Production: the public
# Portal hostname (e.g. https://portal.granulesrecruit.com/login).
VITE_PORTAL_LOGIN_URL=http://localhost:5173/login
